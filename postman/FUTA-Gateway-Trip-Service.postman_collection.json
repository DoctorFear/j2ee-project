                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                      "pm.test('Successful response envelope', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.success).to.eql(true);",
                      "  pm.expect(body).to.have.property('data');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get route stop",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{gatewayBaseUrl}}/api/route-stops/{{routeStopId}}",
                "description": "Missing ID returns 404."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                      "pm.test('Successful response envelope', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.success).to.eql(true);",
                      "  pm.expect(body).to.have.property('data');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Update route stop",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/route-stops/{{routeStopId}}",
                "description": "All fields required. May change routeId or stationId. The same stop can retain its own order.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"routeId\": {{routeId}},\n  \"stationId\": {{stationId}},\n  \"stopOrder\": 0,\n  \"distanceKm\": 0,\n  \"offsetMinutes\": 0,\n  \"allowPickup\": true,\n  \"allowDropOff\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": [],
