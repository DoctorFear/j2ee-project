                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                      "pm.test('Successful response envelope', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.success).to.eql(true);",
                      "  pm.expect(body).to.have.property('data');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Delete route stop",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{gatewayBaseUrl}}/api/route-stops/{{routeStopId}}",
                "description": "Preserves the route and station. Delete stops before deleting a referenced route or station."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
