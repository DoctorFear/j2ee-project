# Cấu hình Docker backend local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=futa-local-postgres
MYSQL_USER=booking
MYSQL_PASSWORD=futa-local-booking
MYSQL_ROOT_PASSWORD=futa-local-mysql-root
AUTH_JWT_SECRET=futa-local-jwt-secret-at-least-32-bytes
BOOKING_INTERNAL_KEY=futa-local-booking-internal-key

GATEWAY_PORT=8080
FRONTEND_URL=http://localhost:5173
FUTA_SEED_ENABLED=true
BOOKING_SEED_ENABLED=true
BOOKING_SEED_USER_ID=6

# Cấu hình thêm khi cần kiểm thử thanh toán hoặc gửi email
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
